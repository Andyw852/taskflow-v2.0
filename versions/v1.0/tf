        j = s.get("job")
        job_txt = ""
        if j:
            job_txt = "  job=%s %s %s" % (j["id"], j["state"],
                                           ("@" + j["info"]) if j["state"] == "R" else j["info"])
        active = "  <== active" if m["active"] is s else ""
        print("  [%-9s] %-18s %-10s %s%s%s" % (
            s["label"], s["name"], s["label_txt"], s["diag"], job_txt, active))
    print("Action: %s" % m["action"])


