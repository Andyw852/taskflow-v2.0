_MAX_INFLIGHT_DEFAULT = int(os.environ.get("TF_MAX_INFLIGHT", "6") or 6)
_BUSY_KINDS = ("R", "PD")   # OTHER=作业已完成/失败（job state 非 R/PD），不算并发占用


def _dag_needs(t, m, s, prev_name):
    """步骤 s 的依赖名列表。skill.yaml 没写 needs 就回退成\"上一步\"，
    这样没改造过的技能（band / elastic）行为完全不变。"""
    sc = step_cfg(t, s["name"], m) or {}
    dep = sc.get("needs")
    if dep is None:
        return [prev_name] if prev_name else []
    if isinstance(dep, str):
        dep = [dep]
    return [str(x) for x in dep]


def _dag_max_inflight(cfg, m):
    st = (m.get("ps") or {}).get("setting") or {}
    for src in (st, cfg):
        v = src.get("max_inflight")
        if v is not None:
            try:
                return max(1, int(v))
            except (TypeError, ValueError):
                pass
    return _MAX_INFLIGHT_DEFAULT


# ---------------------------------------------------------------------------
# patch_max_jobs：按技能限制「同时提交」的超算作业数（v1.11）
# 每个技能单独设上限：task_types.<key>.max_jobs；全局 max_jobs 兜底；环境变量
# TF_MAX_JOBS 再兜底。都不写 = 不限。达到上限后，尚未提交的任务保持 TODO/PREP
# 本地待命，由 watch（每 watch_interval 拉一次状态）在有空位时自动补交。
